{
  "description": "open-brain Codex hooks: startup context injection and Codex transcript summary",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${OPEN_BRAIN_PLUGIN_ROOT}/hooks/scripts/context_inject.py --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${OPEN_BRAIN_PLUGIN_ROOT}/hooks/scripts/codex_session_summary.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
