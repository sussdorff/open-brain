# open-brain environment configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────

# Port to listen on (default: 8091)
PORT=8091

# Public HTTPS URL of this server — used in OAuth metadata and DNS rebinding protection.
# Must match the actual URL clients connect to (no trailing slash).
MCP_SERVER_URL=https://brain.example.com

# ─── Database ─────────────────────────────────────────────────────────────────

# Postgres connection string with pgvector extension.
# Required — no default. Must be a valid postgres URL with pgvector extension.
DATABASE_URL=postgresql://open_brain:CHANGE_ME@localhost:5432/open_brain

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Username shown in the OAuth login form
AUTH_USER=your-username

# Password for the OAuth login form (minimum 8 characters)
AUTH_PASSWORD=changeme-min-8-chars

# Secret key for JWT signing (minimum 32 characters — use a random hex string)
# Generate one: openssl rand -hex 32
JWT_SECRET=changeme-min-32-hex-chars-replace-this-now

# Optional secret for verifying epistemic promotion grants (minimum 32 chars when set).
# Separate from JWT_SECRET — never reused as a fallback. Leave empty to keep
# promotion grant verification fail-closed. Operators mint grants out-of-band.
# Restart the process after rotating this secret (get_config is cached).
# PROMOTION_GRANT_SECRET=
# Comma-separated exact OAuth subjects allowed to mutate epistemic authority.
# Default empty = fail closed. Self-requested admin scope is not enough.
# Restart the process after changing this allowlist (get_config is cached).
# PROMOTION_ADMIN_USERS=
# Optional exact automatic promotion rule version. Empty disables automated promotion.
# PROMOTION_AUTOMATIC_RULE_VERSION=

# Path to the OAuth clients JSON file (for static client registrations)
# In Docker this defaults to /app/clients.json — mount your file there.
CLIENTS_FILE=/app/clients.json

# ─── Embeddings (Voyage AI) ────────────────────────────────────────────────────

# Voyage AI API key — required for saving and searching memories
# Get yours at https://www.voyageai.com/
VOYAGE_API_KEY=your-voyage-api-key

# Embedding model to use (default: voyage-4)
VOYAGE_MODEL=voyage-4

# ─── LLM Provider (for refine_memories and metadata extraction) ───────────────

# Provider: "anthropic" (default) or "openrouter"
LLM_PROVIDER=anthropic

# Default model — used for all "small" calls: entity extraction,
# capture-router classification, tool-use observation extraction, and
# short session/worktree summaries. Must be valid for the chosen provider.
# These are non-reasoning JSON-extraction tasks: prefer a fast NON-reasoning
# model with structured-output support. Avoid heavy reasoning models here —
# deepseek/deepseek-v4-flash is a hybrid reasoner and ran 7-8s per classify.
# Anthropic: claude-haiku-4-5-20251001, claude-sonnet-4-5, etc.
# OpenRouter picks (with OPENROUTER_DATA_COLLECTION=deny, see below):
#   openai/gpt-4.1-nano   ($0.10 in / $0.40 out, 1M ctx) — recommended;
#                          non-reasoning, ~0.8s, zero-retention via Azure endpoint
#   mistralai/ministral-8b-2512 ($0.15/$0.15) — non-reasoning, open-weight
LLM_MODEL=claude-haiku-4-5-20251001

# OPTIONAL: dedicated model for the heavier /api/session-capture endpoint
# (up to ~8k chars input, 1024 output tokens). Falls back to LLM_MODEL if unset.
# Capture is a 7-way classification + shallow field extraction task — it does
# NOT need a reasoning model, so reusing LLM_MODEL (leave this unset) is the
# recommended default. Only set it to point capture at a different model.
# LLM_MODEL_CAPTURE=

# API key for Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# API key for OpenRouter (required when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter provider routing (privacy + structured outputs).
# data collection: "deny" (default) routes only to providers with zero prompt
# retention (no storage, no training); "allow" permits all providers.
# OPENROUTER_DATA_COLLECTION=deny
# Preferred provider order (comma-separated slugs); falls back to any other
# policy-compliant provider. For gpt-4.1-nano, Azure is the zero-retention
# endpoint (Prompt training: No, Zero retention), so pin it:
# OPENROUTER_PROVIDER_ORDER=azure
# NOTE: do NOT set provider.require_parameters in code — it makes OpenRouter
# require every param (incl. the `reasoning` hint) to be provider-supported,
# which 404s non-reasoning models like gpt-4.1-nano.

# ─── Paperless-ngx document references ───────────────────────────────────────

# Base URL of your Paperless-ngx instance (no trailing slash).
# Required to enable the resolve_paperless_reference MCP tool.
# If unset, the tool returns status=not_configured rather than an error.
# PAPERLESS_BASE_URL=https://paperless.example.com

# Paperless-ngx API token. Generate one in Paperless Settings → API Tokens.
# Required alongside PAPERLESS_BASE_URL to resolve document references.
# PAPERLESS_API_TOKEN=your-paperless-api-token

# ─── Plugin hooks ─────────────────────────────────────────────────────────────

# Comma-separated list of API keys for plugin/script access (optional).
# Each key gets memory + evolution scopes. No admin scope is ever granted to API keys.
# Generate a key: python -c "import secrets; print('ob_' + secrets.token_hex(20))"
API_KEYS=

# ─── Guards ───────────────────────────────────────────────────────────────────

# Daily memory write cap per-server. Set to 0 to disable.
MAX_MEMORIES_PER_DAY=500
