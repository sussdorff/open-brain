# Dolt database files (added by bd init)
.dolt/
*.db
src-ts-DEPRECATED/

# Beads issue tracker (local, syncs via Dolt)
.beads/

# Claude Code user config
.claude/

# Library-installed primitives (when this repo is used as a consumer; this repo
# is itself a marketplace, so its source primitives live in top-level dirs
# skills/, hooks/, agents/, etc. — installs into .agents/.claude/ are ignored).
.agents/skills/
.agents/standards/
.agents/agents/
.agents/prompts/

# Beads JSONL export is local; Dolt is the source of truth.
.beads/issues.jsonl

# session-close runtime artifacts (never source of truth, must not be committed)
.session-close.lock
.session-close-state.json*
.worktree-handoff.json
.worktree-turns.jsonl
session-close-summary.txt

# Orchestrator local scratch (never commit)
.orchestration/

# Local intake scratch (never commit)
.intake/

